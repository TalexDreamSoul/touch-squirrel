# 大部分注册、邮箱、代理、上传和 Bridge 参数都可在面板「系统 → 设置」维护。
# 此文件适合首次部署或自动化播种；面板保存时会保持敏感值，不会回显 Token / Key。

EMAIL_MODE=tempmail
# EMAIL_MODE=custom | duckmail | cloudflare | cloudmail | mailnest | moemail | yyds
# EMAIL_DOMAIN=example.com
# EMAIL_API=http://127.0.0.1:8080

# ===== 邮箱 Provider（按 EMAIL_MODE 选择填写）=====
# DEFAULT_DOMAINS=mail.example.com,alt.example.com
# DUCKMAIL_API_BASE=https://api.duckmail.sbs
# DUCKMAIL_API_KEY=
# CLOUDFLARE_API_BASE=https://mail-worker.example.com
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_AUTH_MODE=none # none | x-api-key | x-admin-auth | bearer
# CLOUDFLARE_CUSTOM_AUTH=
# CLOUDFLARE_RANDOMIZE_SUBDOMAIN=1
# CLOUDMAIL_URL=https://cloudmail.example.com
# CLOUDMAIL_ADMIN_EMAIL=admin@example.com
# CLOUDMAIL_PASSWORD=
# MAILNEST_API_KEY=
# MAILNEST_PROJECT_CODE=x-ai001
# MOEMAIL_API_BASE=https://moemail.example.com
# MOEMAIL_API_KEY=
# MOEMAIL_DOMAIN=mail.example.com
# MOEMAIL_EXPIRY_MS=3600000
# YYDS_API_KEY=
# YYDS_JWT=
# YYDS_DEFAULT_DOMAIN=mail.example.com

CLEARANCE_ENABLED=1
REGISTER_PROXY=http://127.0.0.1:40080
FLARESOLVERR_URL=http://127.0.0.1:8191
CLEARANCE_PROXY=http://privoxy:8118
CLEARANCE_URLS=https://accounts.x.ai,https://x.ai,https://status.x.ai,https://console.x.ai,https://auth.x.ai

# TURNSTILE_PROVIDER=browser
# 可选：外接 YesCaptcha 形 farm
# TURNSTILE_PROVIDER=lite
# LITE_SOLVER_URL=http://127.0.0.1:5072
# TURNSTILE_CHROME_PATH=                # 留空自动找 Chrome / CloakBrowser
# TURNSTILE_PYTHON=                     # 留空自动找 Python
# TURNSTILE_SCRIPT=                     # 留空自动找 turnstile_mint.py
# TURNSTILE_INJECT_CLEARANCE=0          # 默认不注入 Cookie/UA
# 以上均可在面板「系统 → 设置」维护。

PROTOCOL_HTTP=1
HTTP_POOL_SIZE=8
TEMPMAIL_LOL_RETRIES=30
# OAUTH_MIN_INTERVAL_SEC=10
# OAUTH_RETRY_SEC=60

HTTPS_PROXY=http://127.0.0.1:40080
HTTP_PROXY=http://127.0.0.1:40080
NO_PROXY=127.0.0.1,localhost

# Resin 粘性代理（可选）
# RESIN_PROXY=http://127.0.0.1:2260
# RESIN_TOKEN=
# RESIN_PLATFORM=Default

# Touch Mail Router / DuckMail（可选）
# MAIL_ROUTER_URL=https://mail.example.com
# MAIL_ROUTER_API_KEY=
# MAIL_ROUTER_DOMAIN=inbound.example.com

PROBE_ENABLED=1
PHYSICAL_CAP=0

# CPA Management 自动上传：只填 CLIProxyAPI 根地址。
# 客户端会自动补 /v0/management；旧的完整管理地址仍兼容。
# 宿主机用 127.0.0.1，不要填写仅容器内可解析的服务名。
# CPA_UPLOAD_ENABLED=0
# CPA_MANAGEMENT_BASE=http://127.0.0.1:8317
# CPA_MANAGEMENT_KEY=
# CPA_UPLOAD_TIMEOUT_SEC=30
# CPA_UPLOAD_RETRIES=2
# CPA_UPLOAD_NAME_TEMPLATE={email}.json
# CPA_UPLOAD_VERIFY=1
# CPA_UPLOAD_MODE=multipart

# ===== Bridge 注册器（可在面板「系统 → 设置」维护）=====
# BRIDGE_REG_FACTORY_ROOT=/opt/reg-factory
# BRIDGE_GROK_PANEL_ROOT=/opt/grok-register-panel
# BRIDGE_OUTLOOK_POOL_DIR=/data/outlook-pool
# BRIDGE_PYTHON=/opt/venv/bin/python

# UPLOAD_CONCURRENCY=3
# UPLOAD_BATCH_SIZE=20
# EXPORT_BATCH_SIZE=500
# EXPORT_CONCURRENCY=15

# ===== 面板：显示时区 =====
# 面板的日历、热力图按哪个时区划分「一天」。留空 = 服务器本机时区。
# 浏览器会带上自己的时区，这里只是浏览器未指定时的兜底。
# 存储的时间戳始终是 UTC，本项只影响展示。
# DISPLAY_TIMEZONE=Asia/Shanghai

# ===== 面板：号池自动巡检（随 squirrel panel 进程运行）=====
# PATROL_ENABLED=0          # 1=面板启动后按间隔巡检
# PATROL_INTERVAL_MIN=30
# PATROL_DEEP_PROBE=0       # 1=下载凭证真实探活（慢但准，可识别限流/耗尽）
# PATROL_CONCURRENCY=10
# QUOTA_PER_ACCOUNT=60      # 单健康号估算日额度（请求数）

# ===== 面板：自动补号（巡检后健康号不足时自动启动注册）=====
# REFILL_ENABLED=0
# REFILL_MIN_HEALTHY=5      # 健康号低于此值触发
# REFILL_BATCH=10           # 每次补号 target
# REFILL_COOLDOWN_MIN=60    # 两次补号最小间隔
# REFILL_DAILY_CAP=50       # 单日补号上限

# ===== 清理限额耗尽号（正式池废号，不删纯 429 限流）=====
# CLEANUP_QUOTA_ENABLED=0   # 1=允许定时清理路径
# CLEANUP_ON_PATROL=1       # 巡检成功后自动跑
# CLEANUP_BACKUP=1          # 删除前下载到 GROK_HOME/pool-backups/
# CLEANUP_DRY_RUN=0         # 1=只报告不删除

# ===== 主从调度（panel 联邦）=====
# CLUSTER_ROLE=standalone   # standalone | master | slave
# CLUSTER_NODE_NAME=node-a
# CLUSTER_PUBLIC_TOKEN=     # 可选，主从一致；公网联邦鉴权
# CLUSTER_MASTER_URL=       # 从节点单主（兼容）
# CLUSTER_MASTER_URLS=      # 从节点多主，逗号/换行分隔
# CLUSTER_STATUS_PASSWORD=  # 公网状态页密码（与联邦密钥独立；空=公开）
# CLUSTER_HEARTBEAT_SEC=15
# CLUSTER_POOL_TARGET=50    # 主：号池维持健康数
# CLUSTER_ASSIGN_MIN=1      # 主：单次分配下限 1-10
# CLUSTER_ASSIGN_MAX=10     # 主：单次分配上限 1-10
# CLUSTER_AUTO_REGISTER=1   # 从：收到分配后自动 grok start
# CLUSTER_AUTO_UPLOAD=1     # 从：批次结束后尝试上传
# CLUSTER_SHARE_INFRASTRUCTURE=0 # 主：允许已鉴权从节点拉取 Resin/MailRouter 配置

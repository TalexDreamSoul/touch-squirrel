# Copy to .env before: docker compose up -d --build  或  make up
#
# 本机默认:
#   make up          → 复用已运行全家桶，或 clearance + 宿主 panel
#   make docker-up   → 完整 Docker 栈
#   make status      → 健康检查

# Panel auth (required if exposed beyond localhost)
PANEL_TOKEN=local-dev-token

# Host port for the web panel
PANEL_PORT=8787

# Optional host debug ports (loopback only in compose)
# WARP_SOCKS_PORT=40000
# PRIVOXY_PORT=40080
# FLARESOLVERR_PORT=8191

# Runtime configuration is seeded into /data/config.env on first boot. Maintain
# email providers, proxies, CPA upload, Resin/MailRouter and Bridge paths from
# the panel after startup; environment variables below are deployment-only.
#
# PANEL_TOKEN / PANEL_PORT / GROK_HOME / TZ / WARP_LICENSE_KEY and host port
# mappings remain Docker deployment settings.

# Official plugin repository. The panel always keeps this source and does not
# allow users to edit or delete it.
# SQUIRREL_OFFICIAL_PLUGIN_REPO=https://github.com/TalexDreamSoul/touch-squirrel

# Optional: passive asset discovery credentials. They take precedence over the
# Hunter settings page for container-only secret injection.
# FOFA_EMAIL=
# FOFA_API_KEY=
# SHODAN_API_KEY=

# Optional Cloudflare WARP+ license
# WARP_LICENSE_KEY=

{
  "id": "claude-registrar",
  "name": "Claude 注册（reg-factory）",
  "version": "0.1.0",
  "description": "驱动 reg-factory register.py 注册 Claude（Playwright + BitBrowser，输出 sessionKey）",
  "kind": ["registrar"],
  "runtime": "bridge",
  "entry": {
    "bridge": "runner.py"
  },
  "hostApi": "0.1",
  "capabilities": [
    "email",
    "browser",
    "http",
    "proxy",
    "storage",
    "secrets",
    "events"
  ],
  "artifactKinds": [
    "session.key"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "latestRt": {
        "type": "boolean",
        "default": true,
        "description": "使用最新 Outlook refresh_token 作为邮箱来源"
      }
    },
    "additionalProperties": false
  },
  "ui": {
    "panels": ["run-console", "settings"]
  },
  "source": "in-tree",
  "status": "active"
}

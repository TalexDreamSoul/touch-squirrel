{
  "id": "grok-panel-registrar",
  "name": "Grok 注册（grok-register-panel）",
  "version": "0.1.0",
  "description": "驱动 grok-register-panel 批量注册 Grok 账号，产出 CPA auth JSON",
  "kind": ["registrar"],
  "runtime": "bridge",
  "entry": {
    "bridge": "runner.py"
  },
  "hostApi": "0.1",
  "capabilities": [
    "email",
    "browser",
    "http",
    "proxy",
    "storage",
    "secrets",
    "events"
  ],
  "artifactKinds": [
    "account.xai"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "workers": {
        "type": "integer",
        "minimum": 1,
        "maximum": 24,
        "default": 1,
        "description": "并发 workers（传给 run_batch_headless.py）"
      }
    },
    "additionalProperties": false
  },
  "ui": {
    "panels": ["run-console", "settings"]
  },
  "source": "in-tree",
  "status": "active"
}
